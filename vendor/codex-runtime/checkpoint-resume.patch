+#[cfg(windows)]
+fn windows_identity(path: &Path) -> Option<(u32, u64)> {
+    use std::os::windows::io::AsRawHandle;
+    use windows_sys::Win32::Storage::FileSystem::{
+        BY_HANDLE_FILE_INFORMATION, GetFileInformationByHandle,
+    };
+    let file = std::fs::File::open(path).ok()?;
+    let mut information = std::mem::MaybeUninit::<BY_HANDLE_FILE_INFORMATION>::uninit();
+    // SAFETY: the handle is borrowed from an open file and the output points to
+    // correctly sized, aligned writable memory. The file outlives this call.
+    if unsafe { GetFileInformationByHandle(file.as_raw_handle(), information.as_mut_ptr()) } == 0 {
+        return None;
+    }
+    // SAFETY: a successful GetFileInformationByHandle initialized every field.
+    let information = unsafe { information.assume_init() };
+    let file_index =
+        (u64::from(information.nFileIndexHigh) << 32) | u64::from(information.nFileIndexLow);
+    if file_index == 0 {
+        // Some network/filesystem providers report an unavailable identity as zero.
+        return None;
+    }
+    Some((information.dwVolumeSerialNumber, file_index))
+}
