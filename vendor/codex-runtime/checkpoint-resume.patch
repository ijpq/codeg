+mod codeg_revision_tests {
+    use super::*;
+    use std::io::Write;
+    #[tokio::test]
+    async fn revision_invalidates_on_append_and_replacement() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("rollout.jsonl");
+        std::fs::write(&path, b"original\n").unwrap();
+        let original = read(&path).await.expect("file identity");
+        assert_eq!(read(&path).await, Some(original.clone()));
+        assert!(super::super::validate_local_history_revision(&path, &original).await);
+        let foreign = dir.path().join("foreign.jsonl");
+        std::fs::write(&foreign, b"original\n").unwrap();
+        assert!(!super::super::validate_local_history_revision(&foreign, &original).await);
+        std::fs::OpenOptions::new()
+            .append(true)
+            .open(&path)
+            .unwrap()
+            .write_all(b"delta\n")
+            .unwrap();
+        let appended = read(&path).await.expect("append identity");
+        assert_ne!(original, appended);
+        assert!(!super::super::validate_local_history_revision(&path, &original).await);
+        assert!(super::super::validate_local_history_revision(&path, &appended).await);
+        let modified = std::fs::metadata(&path).unwrap().modified().unwrap();
+        let replacement = dir.path().join("replacement.jsonl");
+        std::fs::write(&replacement, b"original\ndelta\n").unwrap();
+        std::fs::File::options()
+            .write(true)
+            .open(&replacement)
+            .unwrap()
+            .set_times(std::fs::FileTimes::new().set_modified(modified))
+            .unwrap();
+        std::fs::rename(&replacement, &path).unwrap();
+        assert_ne!(read(&path).await.expect("replacement identity"), appended);
+        assert!(!super::super::validate_local_history_revision(&path, &appended).await);
+        assert!(
+            !super::super::validate_local_history_revision(
+                &foreign.with_extension("missing"),
+                &original
+            )
+            .await
+        );
+    }
