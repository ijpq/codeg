@@ -0,0 +1,188 @@
+//! Opt-in resume of legacy files at a native, state-complete compaction.
+//! Never used for UI history. No cache or original file is written here.
+use codex_protocol::protocol::{EventMsg, SessionMetaLine};
+use codex_rollout::{ReverseJsonlScanner, RolloutItem, ScanOutcome};
+use std::fs::File;
+use std::io::{self, Read, Seek, SeekFrom};
+use std::path::Path;
+
+const SCAN_LIMIT: u64 = 64 * 1024 * 1024;
+
+struct BudgetedFile {
+    file: File,
+    remaining: u64,
+}
+impl Read for BudgetedFile {
+    fn read(&mut self, bytes: &mut [u8]) -> io::Result<usize> {
+        if self.remaining == 0 {
+            return Err(io::Error::other("checkpoint scan budget exhausted"));
+        }
+        let limit = bytes.len().min(self.remaining as usize);
+        let read = self.file.read(&mut bytes[..limit])?;
+        self.remaining -= read as u64;
+        Ok(read)
+    }
+}
+impl Seek for BudgetedFile {
+    fn seek(&mut self, pos: SeekFrom) -> io::Result<u64> {
+        self.file.seek(pos)
+    }
+}
+
+pub(super) fn try_load(path: &Path, meta: SessionMetaLine) -> io::Result<Option<Vec<RolloutItem>>> {
+    let reader = BudgetedFile {
+        file: File::open(path)?,
+        remaining: SCAN_LIMIT,
+    };
+    let mut scanner = ReverseJsonlScanner::new(reader)?;
+    let mut newest_first = Vec::new();
+    let mut companion_context = false;
+    let mut companion_world = false;
+    while let Some(line) = scanner.scan_next_rollout_line()? {
+        let ScanOutcome::Parsed(line) = line else {
+            return Ok(None);
+        };
+        match &line.item {
+            // Rollback may refer to an older turn. Let canonical full replay decide.
+            RolloutItem::EventMsg(EventMsg::ThreadRolledBack(_)) => return Ok(None),
+            RolloutItem::SessionMeta(_) => return Ok(None),
+            RolloutItem::TurnContext(_) => companion_context = true,
+            RolloutItem::WorldState(world) if world.full => companion_world = true,
+            RolloutItem::Compacted(compacted) => {
+                // Only the newest compaction is eligible. In particular an old summary
+                // cannot reconstruct window, attribution or previous-turn settings.
+                if compacted.replacement_history.is_none()
+                    || compacted.window_number.is_none()
+                    || compacted.resume_metadata.is_none()
+                    || !companion_context
+                    || !companion_world
+                {
+                    return Ok(None);
+                }
+                newest_first.push(line.item);
+                newest_first.push(RolloutItem::SessionMeta(meta));
+                newest_first.reverse();
+                tracing::info!(
+                    items = newest_first.len(),
+                    "CodeG legacy resume: validated native checkpoint"
+                );
+                return Ok(Some(newest_first));
+            }
+            _ => {}
+        }
+        newest_first.push(line.item);
+    }
+    Ok(None)
+}
+
