+        assert!(try_load(file.path(), meta).unwrap().is_none());
+    }
+    #[test]
+    fn probe_has_strict_byte_budget() {
+        let fixture = tempfile::NamedTempFile::new().unwrap();
+        std::fs::write(fixture.path(), b"bounded bytes").unwrap();
+        let mut reader = BudgetedFile {
+            file: File::open(fixture.path()).unwrap(),
+            remaining: 3,
+        };
+        let mut bytes = [0; 20];
+        assert_eq!(reader.read(&mut bytes).unwrap(), 3);
+        assert!(reader.read(&mut bytes).is_err());
+    }
