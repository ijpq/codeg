+        std::fs::write(&one, b"same").unwrap();
+        std::fs::write(&two, b"same").unwrap();
+        assert_ne!(
+            windows_identity(&one).unwrap(),
+            windows_identity(&two).unwrap()
+        );
+    }
+}
