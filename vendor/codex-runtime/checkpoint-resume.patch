+            resume_metadata: Some(codex_history::CompactionResumeMetadata {
+                multi_agent_version: Some(MultiAgentVersion::V1),
+                last_started_turn_id: Some("prior".into()),
+                turn_attribution: None,
+                previous_turn_settings: None,
