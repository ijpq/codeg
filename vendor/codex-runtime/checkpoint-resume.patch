+async fn codeg_checkpoint_matches_full_replay_with_images_and_tools() {
+    let (session, turn_context) = make_session_and_context().await;
+    let (mut full, _) = sample_rollout(&session, &turn_context).await;
+    let checkpoint_index = full
+        .iter()
+        .rposition(|item| matches!(item, RolloutItem::Compacted(_)))
+        .unwrap();
+    let RolloutItem::Compacted(checkpoint) = &mut full[checkpoint_index] else {
+        unreachable!()
+    };
+    checkpoint.replacement_history =
+        Some(vec![user_message("state-complete native summary").into()]);
+    checkpoint.resume_metadata = Some(codex_history::CompactionResumeMetadata {
+        multi_agent_version: Some(MultiAgentVersion::V1),
+        last_started_turn_id: None,
+        turn_attribution: None,
+        previous_turn_settings: None,
+    });
+    for value in [
+        serde_json::json!({"type":"message","role":"user","content":[
+            {"type":"input_text","text":"image reference remains intact"},
+            {"type":"input_image","image_url":"data:image/png;base64,VEVTVA=="}
+        ]}),
+        serde_json::json!({"type":"function_call","call_id":"paired","name":"exec_command","arguments":"{}"}),
+        serde_json::json!({"type":"function_call_output","call_id":"paired","output":"saved result"}),
+        serde_json::json!({"type":"function_call","call_id":"pending","name":"exec_command","arguments":"{}"}),
+    ] {
+        let item: ResponseItem = serde_json::from_value(value).unwrap();
+        full.push(RolloutItem::ResponseItem(item.into()));
+    }
+    let bounded = &full[checkpoint_index..];
+    let full_state = session
+        .reconstruct_history_from_rollout(&turn_context, &full)
+        .await;
+    let bounded_state = session
+        .reconstruct_history_from_rollout(&turn_context, bounded)
+        .await;
+    assert_eq!(full_state, bounded_state);
+    let full_initial = InitialHistory::Forked(full.clone());
+    let bounded_initial = InitialHistory::Forked(bounded.to_vec());
+    assert_eq!(
+        crate::thread_rollout_truncation::initial_history_has_prior_user_turns(&full_initial),
+        crate::thread_rollout_truncation::initial_history_has_prior_user_turns(&bounded_initial)
+    );
+    assert_eq!(
+        full_initial.get_multi_agent_version(),
+        bounded_initial.get_multi_agent_version()
+    );
+    let encoded = serde_json::to_string(&raw_envelopes(&bounded_state.history)).unwrap();
+    assert!(encoded.contains("data:image/png;base64,VEVTVA=="));
+    assert!(encoded.contains("saved result"));
+    assert!(encoded.contains("pending"));
+    assert!(!encoded.contains("assistant reply one"));
+}
