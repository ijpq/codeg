+    items.push(RolloutItem::EventMsg(
+        serde_json::from_value(serde_json::json!({
+            "type":"task_complete", "turn_id":"prior", "last_agent_message":null
+        }))
+        .unwrap(),
+    ));
+    let initial = |items: Vec<RolloutItem>| {
+        InitialHistory::Resumed(ResumedHistory {
+            history_revision: None,
+            conversation_id: tid,
+            history: Arc::new(items),
+            rollout_path: None,
+        })
+    };
+    let valid = initial(items.clone());
+    assert!(crate::can_resume_legacy_checkpoint(&valid));
+    let mut foreign_terminal = items.clone();
+    if let RolloutItem::EventMsg(EventMsg::TurnComplete(event)) =
+        foreign_terminal.last_mut().unwrap()
+    {
+        event.turn_id = "different task".into();
+    }
+    assert!(!crate::can_resume_legacy_checkpoint(&initial(
+        foreign_terminal
+    )));
+    let mut unmatched_input = items.clone();
+    unmatched_input.push(RolloutItem::ResponseItem(
+        user_message("unfinished user input").into(),
+    ));
+    assert!(!crate::can_resume_legacy_checkpoint(&initial(
+        unmatched_input
+    )));
+    let mut running = items.clone();
+    running.push(RolloutItem::EventMsg(
+        serde_json::from_value(serde_json::json!({
+            "type":"task_started", "turn_id":"unfinished", "model_context_window":262144
+        }))
+        .unwrap(),
+    ));
+    assert!(!crate::can_resume_legacy_checkpoint(&initial(running)));
+    let eof_checkpoint = initial(items[1..].to_vec());
+    assert!(!crate::can_resume_legacy_checkpoint(&eof_checkpoint));
+    assert!(!crate::can_resume_legacy_checkpoint(&initial(
+        items[..2].to_vec()
+    )));
+    if let RolloutItem::EventMsg(EventMsg::ThreadSettingsApplied(event)) = &mut items[2] {
+        event.thread_id = Some(ThreadId::new());
+    }
+    assert!(!crate::can_resume_legacy_checkpoint(&initial(
+        items.clone()
+    )));
+    if let RolloutItem::EventMsg(EventMsg::ThreadSettingsApplied(event)) = &mut items[2] {
+        event.thread_id = Some(tid);
+    }
+    if let RolloutItem::Compacted(checkpoint) = &mut items[1] {
+        checkpoint
+            .resume_metadata
+            .as_mut()
+            .unwrap()
+            .multi_agent_version = None;
+    }
+    assert!(!crate::can_resume_legacy_checkpoint(&initial(items)));
+}
