+/// Conservative validation for a bounded legacy resume. The omitted prefix must
+/// not change first-turn detection, runtime selection, or owned thread settings.
+/// This deliberately rejects ambiguous checkpoints rather than guessing text.
+pub fn can_resume_legacy_checkpoint(history: &InitialHistory) -> bool {
+    let InitialHistory::Resumed(resumed) = history else {
+        return false;
+    };
+    let checkpoint_turn_id = resumed
+        .history
+        .iter()
+        .rev()
+        .find_map(|item| match item {
+            RolloutItem::Compacted(checkpoint) => Some(
+                checkpoint
+                    .resume_metadata
+                    .as_ref()
+                    .and_then(|metadata| metadata.last_started_turn_id.as_deref()),
+            ),
+            _ => None,
+        })
+        .flatten();
+    let Some(checkpoint_turn_id) = checkpoint_turn_id else {
+        return false;
+    };
+    let checkpoint_closed = resumed.history.iter().any(|item| match item {
+        RolloutItem::EventMsg(EventMsg::TurnComplete(event)) => event.turn_id == checkpoint_turn_id,
+        RolloutItem::EventMsg(EventMsg::TurnAborted(event)) => {
+            event.turn_id.as_deref() == Some(checkpoint_turn_id)
+        }
+        _ => false,
+    });
+    checkpoint_closed
+        && !crate::thread_manager::snapshot_ends_mid_turn(history)
+        && initial_history_has_prior_user_turns(history)
+        && history.get_multi_agent_version().is_some()
+        && resumed
+            .history
+            .iter()
+            .rev()
+            .find_map(|item| match item {
+                RolloutItem::EventMsg(
+                    event @ (EventMsg::TurnStarted(_)
+                    | EventMsg::TurnComplete(_)
+                    | EventMsg::TurnAborted(_)),
+                ) => Some(event),
+                _ => None,
+            })
+            .is_some_and(|event| {
+                matches!(event, EventMsg::TurnComplete(_) | EventMsg::TurnAborted(_))
+            })
+        && resumed.history.iter().any(|item| {
+            matches!(item,
+            RolloutItem::EventMsg(EventMsg::ThreadSettingsApplied(event))
+                if event.thread_id == Some(resumed.conversation_id))
+        })
+}
